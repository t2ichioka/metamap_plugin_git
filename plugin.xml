<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    id="jst-metamap-sdk-plugin"
    version="0.0.17">

    <name>MataMapSDKPlugin</name>
    <description>MataMapSDK Plugin For Cordova</description>
    <author>JST</author>
    <license>MIT</license>
    <engines>
        <engine name="cordova" version=">=7.1.0"/>
    </engines>
    <js-module src="www/metamap.js" name="metamap">
        <clobbers target="MetaMap" />
    </js-module>
    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="CallMetaMap">
                <param name="ios-package" value="CallMetaMap"/>
                <param name="onload" value="true" />
            </feature>
        </config-file>
        <source-file src="src/ios/CallMetaMap.swift" target-dir="src/ios" />
        <source-file src="src/ios/MapViewController.swift" target-dir="src/ios" />
        <source-file src="sdk/ios/artifacts/Metamap.xcframework" target-dir="lib" framework="true" />
        <source-file src="sdk/ios/artifacts/MetamapPositioning.xcframework" target-dir="lib" framework="true" />
        <source-file src="sdk/ios/artifacts/MetamapPositioningCore.xcframework" target-dir="lib" framework="true" />
        <framework src="sdk/ios/artifacts/Metamap.xcframework" embed="true" custom="true" /> 
        <framework src="sdk/ios/artifacts/MetamapPositioning.xcframework"   embed="true" custom="true" /> 
        <framework src="sdk/ios/artifacts/Metamap.xcframework" embed="true" custom="true" /> 
    </platform>
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="CallMetaMap"> 
                <param name="android-package" value="jst.metamap.CallMetaMap"/>
                <param name="onload" value="true" />
            </feature>
        </config-file>
        <source-file src="src/android/jst/metamap/CallMetaMap.kt" target-dir="app/src/main/java/jst/metamap" /> 
        <source-file src="src/android/jst/metamap/MetaMapActivity.kt" target-dir="app/src/main/java/jst/metamap" /> 
        <framework src="sdk/android/build-extras.gradle" custom="true" type="gradleReference"/>
        <source-file src="sdk/android/metamap" target-dir="/" /> 
        <framework src="jp.metamaps.positioning:metamap-mapview:0.3.0" custom="true" type="gradleReference" />      
    </platform>
</plugin>